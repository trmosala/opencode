#!/usr/bin/env bash

# CookieMonster ships as an internal macOS app, including its private backend.
# An upstream CLI installer would replace the fork with a different product.
printf '%s\n' "Install or update CookieMonster through the desktop updater or the internal releases:" >&2
printf '%s\n' "https://github.com/trmosala/opencode/releases/latest" >&2
exit 1
